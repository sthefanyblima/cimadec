// Schema do banco do CIMADEC.
// Duas entidades relacionadas: User 1—N Ocorrencia.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Papel do usuário. Mínimo necessário: quem reporta (cidadão) x quem monitora (operador).
enum Role {
  CIDADAO
  OPERADOR
}

// Categorias de ocorrência monitoradas pela Defesa Civil (espelham o front).
enum Categoria {
  ENCHENTE
  DESLIZAMENTO
  LIXO
  QUEDA_ARVORE
  INFRAESTRUTURA
  OUTRO
}

// Ciclo de vida da ocorrência (espelha os indicadores do painel do operador).
enum Status {
  RECEBIDO
  EM_ANALISE
  RESOLVIDO
  CRITICO
}

model User {
  id          String       @id @default(uuid())
  nome        String
  email       String       @unique
  senhaHash   String
  role        Role         @default(CIDADAO)
  ocorrencias Ocorrencia[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@map("users")
}

model Ocorrencia {
  id        String    @id @default(uuid())
  categoria Categoria
  descricao String
  endereco  String
  latitude  Float?
  longitude Float?
  status    Status    @default(RECEBIDO)

  // Relação com o autor (cidadão que registrou).
  autor   User   @relation(fields: [autorId], references: [id], onDelete: Cascade)
  autorId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([autorId])
  @@index([status])
  @@map("ocorrencias")
}
