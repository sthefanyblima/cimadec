# ================================================================
# Variáveis de ambiente do back-end CIMADEC
# Copie este arquivo para `.env` e ajuste os valores.
# NUNCA versione o arquivo `.env` (ele está no .gitignore).
# ================================================================

# String de conexão do PostgreSQL usada pelo Prisma.
# Formato: postgresql://USUARIO:SENHA@HOST:PORTA/BANCO?schema=public
# Os valores abaixo batem com o docker-compose.yml deste projeto.
DATABASE_URL="postgresql://cimadec:cimadec@localhost:5432/cimadec?schema=public"

# Segredo usado para assinar o JWT da sessão. Troque por um valor longo e aleatório.
JWT_SECRET="troque-por-um-segredo-longo-e-aleatorio"

# Tempo de validade do token/cookie de sessão.
JWT_EXPIRES_IN="1d"

# Porta em que a API sobe.
PORT=3000

# Ambiente: development | production (controla flags de cookie e detalhe de erro).
NODE_ENV=development

# Origem permitida no CORS (o front do CIMADEC). Use * apenas em desenvolvimento.
CORS_ORIGIN="http://localhost:5500"
